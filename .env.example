# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# --- LiveKit (agent/agent.py) — required to run a real call session --------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Deepgram STT (agent/agent.py) — required to run a real call session --
DEEPGRAM_API_KEY=

# --- Moss semantic retrieval (db/moss_client.py) --------------------------
# Without these set, db/moss_client.py runs in STUB_MODE (in-memory,
# keyword-overlap "search") so the rest of the stack stays runnable.
MOSS_API_KEY=
MOSS_ENDPOINT=

# --- TTS (agent/agent.py) --------------------------------------------------
# "edge-tts" (free, no key, default — Kokoro isn't wired up yet, see
# agent/agent.py's _synthesize_kokoro docstring for why) or "kokoro" once it is.
TTS_PROVIDER=edge-tts
EDGE_TTS_VOICE=en-US-AriaNeural
# KOKORO_MODEL_PATH= / KOKORO_SERVER_URL=   # TODO: fill in once self-host path is decided

# --- LLM for follow-up generation (agent/agent.py) -------------------------
# Defaults to Anthropic. Without this set, agent.py uses a templated
# follow-up instead of a real LLM call, so the loop stays runnable without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- agent runtime (agent/agent.py) -----------------------------------------
CALLS_DIR=calls
DB_PATH=voice_checkin.db
FALLBACK_TIMEOUT_S=1.2
