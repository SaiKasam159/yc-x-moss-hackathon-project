# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# --- LiveKit (agent/agent.py) ---------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Deepgram STT (agent/agent.py) ----------------------------------------
DEEPGRAM_API_KEY=

# --- Moss semantic retrieval (db/moss_client.py) --------------------------
# Without these set, db/moss_client.py runs in STUB_MODE (in-memory,
# keyword-overlap "search") so the rest of the stack stays runnable.
MOSS_API_KEY=
MOSS_ENDPOINT=

# --- TTS (agent/agent.py) --------------------------------------------------
# "kokoro" (self-hosted, free) or "edge-tts" (free, no key, fallback if
# Kokoro setup isn't working yet).
TTS_PROVIDER=kokoro
# KOKORO_MODEL_PATH= / KOKORO_SERVER_URL=   # TODO: fill in once self-host path is decided

# --- LLM for response generation (agent/agent.py, reports/generate_report.py) ---
# TODO: provider not yet chosen — add e.g. ANTHROPIC_API_KEY or OPENAI_API_KEY
# here once decided, and wire it into agent.py / reports/generate_report.py.
LLM_API_KEY=
